{% comment %} sections/featured-collection.liquid {% endcomment %}

<div class="tw-{{ section.settings.color_scheme }} tw-py-12">
  <div class="tw-container tw-mx-auto tw-px-4">
    {%- if section.settings.title != blank -%}
      <h2 class="tw-text-3xl tw-font-bold tw-font-header tw-text-center tw-mb-8">
        {{ section.settings.title | escape }}
      </h2>
    {%- endif -%}

    <div class="tw-grid tw-grid-cols-2 sm:tw-grid-cols-3 md:tw-grid-cols-{{ section.settings.columns_desktop }} tw-gap-4">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {% comment %} Placeholder content if no products are in the collection {% endcomment %}
        {% for i in (1..section.settings.products_to_show) %}
          <div class="tw-product-card tw-border tw-border-gray-200 tw-p-4">
            <div class="tw-aspect-w-1 tw-aspect-h-1 tw-w-full tw-overflow-hidden tw-bg-gray-200">
              {{ 'product-1' | placeholder_svg_tag: 'tw-w-full tw-h-full tw-object-center tw-object-cover' }}
            </div>
            <h3 class="tw-text-lg tw-font-medium tw-text-gray-700">Product Title {{ i }}</h3>
            <p class="tw-mt-1 tw-text-sm tw-text-gray-500">Product description</p>
            <p class="tw-mt-4 tw-text-base tw-font-medium tw-text-gray-900">$0.00</p>
          </div>
        {% endfor %}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="tw-mt-8 tw-text-center">
        <a
          href="{{ section.settings.collection.url }}"
          class="tw-inline-block tw-bg-button tw-text-button-label tw-px-6 tw-py-2 tw-rounded-button tw-no-underline hover:tw-opacity-75"
        >
          {{ section.settings.view_all_text | default: 'View All' | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Featured Collection",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of Products to Show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of Columns (Desktop)"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Show 'View All' Button"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "default": "View All",
      "label": "View All Button Text"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1",
      "options": [
        {
          "value": "scheme-1",
          "label": "t:settings_schema.colors.settings.color_schemes.options.scheme_1.label"
        },
        {
          "value": "scheme-2",
          "label": "t:settings_schema.colors.settings.color_schemes.options.scheme_2.label"
        },
        {
          "value": "scheme-3",
          "label": "t:settings_schema.colors.settings.color_schemes.options.scheme_3.label"
        },
        {
          "value": "scheme-4",
          "label": "t:settings_schema.colors.settings.color_schemes.options.scheme_4.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}
