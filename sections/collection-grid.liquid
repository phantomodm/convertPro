{% comment %} sections/collection-grid.liquid {% endcomment %}
<div id="collection-error-message" class="tw-hidden tw-text-red-500 tw-py-4"></div>

<div id="loading-spinner" class="tw-hidden tw-flex tw-justify-center tw-py-8">
  <div class="tw-animate-spin tw-rounded-full tw-h-12 tw-w-12 tw-border-t-2 tw-border-b-2 tw-border-gray-900"></div>
</div>

<div id="product-grid" class="tw-grid tw-grid-cols-2 sm:tw-grid-cols-3 lg:tw-grid-cols-4 tw-gap-4">
  {% for product in collection.products %}
    {% render 'product-card', product: product %}
  {% else %}
    <p class="tw-col-span-full tw-text-center">{{ 'products.collection.no_products' | t }}</p>
  {% endfor %}
</div>

{% comment %} Pagination (Re-rendered inside the section) {% endcomment %}
{% if paginate.pages > 1 %}
  <div class="tw-pagination tw-flex tw-justify-center tw-items-center tw-mt-8">
    {% if paginate.previous %}
      <a
        href="{{ paginate.previous.url }}"
        class="tw-pagination-prev tw-px-4 tw-py-2 tw-mr-2 tw-border tw-border-gray-300 tw-bg-white tw-text-gray-700 tw-rounded-md hover:tw-bg-gray-100"
      >
        <span aria-hidden="true">&laquo;</span> {{ paginate.previous.title }}
      </a>
    {% endif %}

    {% for part in paginate.parts %}
      {% if part.is_link %}
        <a
          href="{{ part.url }}"
          class="tw-pagination-number tw-px-4 tw-py-2 tw-mx-1 tw-border tw-border-gray-300 tw-bg-white tw-text-gray-700 tw-rounded-md hover:tw-bg-gray-100"
        >
          {{ part.title }}
        </a>
      {% else %}
        {% if part.title == paginate.current_page %}
          <span class="tw-pagination-current tw-px-4 tw-py-2 tw-mx-1 tw-border tw-border-gray-300 tw-bg-gray-800 tw-text-white tw-rounded-md">
            {{ part.title }}
          </span>
        {% else %}
          <span class="tw-pagination-ellipsis tw-px-4 tw-py-2 tw-mx-1 tw-text-gray-700">
            {{ part.title }}
          </span>
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if paginate.next %}
      <a
        href="{{ paginate.next.url }}"
        class="tw-pagination-next tw-px-4 tw-py-2 tw-ml-2 tw-border tw-border-gray-300 tw-bg-white tw-text-gray-700 tw-rounded-md hover:tw-bg-gray-100"
      >
        {{ paginate.next.title }}
        <span aria-hidden="true">&raquo;</span>
      </a>
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Settings for product grid"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ],
  "presets": [
    {
      "name": "Collection Grid"
    }
  ]
}
{% endschema %}
